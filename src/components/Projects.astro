---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="أعمال سابقة" href="projects">
  {
    projects.map(({ name, summary, image, linkPreview, linkSource }, index) => {
      const top = 98 + index * 40;

      return (
        <div
          style={`top: ${top}px;`}
          class="mb-12 rounded-2xl border border-neutral/20 bg-black md:sticky"
        >
          <div class="bg-difu relative z-1 grid min-h-[580px] w-full grid-rows-[1fr_auto] rounded-2xl bg-[#232529]/95 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-size-[128px] before:bg-repeat before:opacity-5 before:content-[''] sm:grid-cols-2 sm:grid-rows-1 md:min-h-96">

            <div class="px-6 pt-12">
              <h3 class="mb-5 font-serif text-4xl font-medium text-primary">
                {name}
              </h3>
              <p class="text-lg text-[#b7bcc4]">{summary}</p>
              <div class="flex justify-center gap-5 py-10 text-primary">
                <a
                  href={linkPreview}
                  target="_blank"
                  class="text-xl after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
                >
                  اقرأ المزيد
                </a>
              </div>
            </div>

            <div class="flex items-end justify-end overflow-hidden">
             <Image
                class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-top-left object-cover sm:h-[85%] sm:w-full"
                src={image}
                alt=""
                width="736"
                height="483"
              />
            </div>

          </div>
        </div>
      );
    })
  }
</Section>
