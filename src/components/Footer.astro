---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="w-full border-t border-neutral/20 px-5 pt-5 pb-8 text-center text-white"
>
  <ul class="mb-5 flex flex-wrap justify-center gap-x-5 text-s">
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a
  href={href}
  target="_blank"
  class="inline-block px-4 py-3 hover:text-primary
         after:content-[''] after:inline-block after:ms-1
         after:w-4 after:h-4
         after:bg-[#636569]
         after:[mask-image:url(/external.svg)] after:[mask-size:contain] after:[mask-repeat:no-repeat] after:[mask-position:center]"
>
  {text}
</a>
        </li>
      ))
    }
  </ul>
<p class="text-xs">
    {author} © {currentYear}. All Rights Reserved
  </p>
</footer>
